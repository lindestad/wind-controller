/dts-v1/;
#include <espressif/esp32c3/esp32c3_wroom_n4.dtsi>
#include <espressif/partitions_0x0_default.dtsi>
#include <zephyr/dt-bindings/pinctrl/esp-pinctrl-common.h>
#include <zephyr/dt-bindings/pinctrl/esp32c3-pinctrl.h>
#include <zephyr/dt-bindings/pinctrl/esp32c3-gpio-sigmap.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
    model = "LINDESTAD Wind Controller B.3";
    compatible = "lindestad,wind-controller";
    chosen {
        zephyr,sram = &sram1;
        zephyr,flash = &flash0;
        zephyr,code-partition = &slot0_partition;
    };
    zephyr,user {
        fan-enable-gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
        status-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
        tach-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>, <&gpio0 1 GPIO_ACTIVE_HIGH>,
                     <&gpio0 3 GPIO_ACTIVE_HIGH>, <&gpio0 20 GPIO_ACTIVE_HIGH>;
        pwms = <&ledc0 0 PWM_NSEC(40000) PWM_POLARITY_NORMAL>,
               <&ledc0 1 PWM_NSEC(40000) PWM_POLARITY_NORMAL>,
               <&ledc0 2 PWM_NSEC(40000) PWM_POLARITY_NORMAL>,
               <&ledc0 3 PWM_NSEC(40000) PWM_POLARITY_NORMAL>;
    };
};
&uart0 { status = "disabled"; };
&uart1 { status = "disabled"; };
&wifi { status = "disabled"; };
&esp32_bt_hci { status = "disabled"; };
&usb_serial { status = "okay"; };
&wdt0 { status = "okay"; };
&pinctrl {
    wind_pwm: wind_pwm {
        group1 {
            pinmux = <LEDC_CH0_GPIO4>, <LEDC_CH1_GPIO5>,
                     <LEDC_CH2_GPIO6>, <LEDC_CH3_GPIO7>;
            output-enable;
        };
    };
};
&ledc0 {
    status = "okay";
    pinctrl-0 = <&wind_pwm>;
    pinctrl-names = "default";
    #address-cells = <1>;
    #size-cells = <0>;
    // Inverted sets the driver's initial stopped output high. Runtime calls
    // use NORMAL polarity and explicit gate duty: inversion occurs once.
    channel0@0 { reg = <0>; timer = <0>; inverted; };
    channel1@1 { reg = <1>; timer = <0>; inverted; };
    channel2@2 { reg = <2>; timer = <0>; inverted; };
    channel3@3 { reg = <3>; timer = <0>; inverted; };
};
